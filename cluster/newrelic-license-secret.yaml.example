# Not applied automatically, and deliberately named *.example so it's
# never accidentally committed with a real key in it.
#
# Copy this to newrelic-license-secret.yaml (gitignored - see below),
# fill in the real license key, then:
#   kubectl create namespace monitoring --dry-run=client -o yaml | kubectl apply -f -
#   kubectl apply -f cluster/newrelic-license-secret.yaml
#
# US-region accounts use a license key starting with nothing special;
# EU-region accounts' keys are functionally the same format - the
# region is determined by which OTLP endpoint you point at
# (otlp.nr-data.net vs otlp.eu01.nr-data.net), set in
# otel-collector-daemonset-values.yaml / otel-collector-cluster-values.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: newrelic-license
  namespace: monitoring
type: Opaque
stringData:
  license-key: "REPLACE_ME_WITH_REAL_NEW_RELIC_LICENSE_KEY"
